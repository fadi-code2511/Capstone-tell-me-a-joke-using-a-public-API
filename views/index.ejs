<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Random Joke</title>
    <link rel="stylesheet" href="style/style.css">
</head>
<body>
    <div class="hero-sec">
        <div class="joke-con">
            <h1>Random Joke</h1>
            <% if (joke) { %>
                <% if (joke.type === "single") { %>
                    <p><%= joke.joke %></p>
                <% } else { %>
                    <p><%= joke.setup %></p>
                    <p><strong><%= joke.delivery %></strong></p>
                <% } %>
            <% } else { %>
                <p>Error retrieving joke. Try again later.</p>
            <% } %>
            <a href="/" class="btn-style">Another joke!</a>
        </div>

    </div>
    
    

</body>
</html>
